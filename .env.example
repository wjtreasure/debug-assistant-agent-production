# Copy this file to .env and fill in the provider settings. .env is ignored.

# Use mock for deterministic smoke tests. Use openai_compatible for diagnosis.
DEBUG_AGENT_PROVIDER=mock
DEBUG_AGENT_BASE_URL=https://api.openai.com/v1
DEBUG_AGENT_API_KEY=
DEBUG_AGENT_MODEL=gpt-5.6
DEBUG_AGENT_REFLECTION_MODEL=
DEBUG_AGENT_CRITIC_MODEL=
DEBUG_AGENT_TIMEOUT=60
DEBUG_AGENT_TEMPERATURE=0

# Runtime safety limits. These are intentionally conservative defaults.
DEBUG_AGENT_MAX_STEPS=20
DEBUG_AGENT_MAX_TOOL_CALLS=45
DEBUG_AGENT_MAX_LLM_CALLS=40
DEBUG_AGENT_MAX_TOTAL_TOKENS=180000
DEBUG_AGENT_MAX_WALL_TIME_SECONDS=900
DEBUG_AGENT_FINALIZATION_RESERVE_SECONDS=90
DEBUG_AGENT_MAX_CONTEXT_CHARS=50000
DEBUG_AGENT_TRACE_DIR=.debug_assistant/traces

# Optional local asset manifest. Supply paths when running a CloudOps case.
# DEBUG_AGENT_DOMAIN_ASSET_MANIFEST=/path/to/DOMAIN_ASSET_MANIFEST.json
